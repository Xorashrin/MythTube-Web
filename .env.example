# Copy to .env.local for development, or set these in Vercel / Cloudflare project settings.
# EXPO_PUBLIC_* values are compiled into the bundle at build time.

# Where API traffic (JSON, HTML, plugin scripts) goes. Default: the Vercel Edge function on the same domain.
EXPO_PUBLIC_PROXY_URL=/api/proxy

# Where video bytes go. Leave equal to the line above to proxy media through Vercel, or point it at your
# Cloudflare Worker (recommended: no bandwidth charge), e.g. https://mythtube-proxy.<account>.workers.dev
EXPO_PUBLIC_MEDIA_PROXY=/api/proxy
